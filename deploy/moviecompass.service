# systemd service for the Raspberry Pi.
# Install: sudo cp deploy/moviecompass.service /etc/systemd/system/
#          sudo systemctl daemon-reload && sudo systemctl enable --now moviecompass
# Logs:    journalctl -u moviecompass -f

[Unit]
Description=MovieCompass (Athens Cinemas)
Wants=network-online.target
After=network-online.target
# Give up after 3 starts within 15 minutes, so a crash loop doesn't re-scrape Athinorama and re-download ~240 MB from IMDb over and over.
# Start again with: sudo systemctl reset-failed moviecompass && sudo systemctl start moviecompass (deploy.sh does this too.) A reboot also starts it again.
StartLimitIntervalSec=15min
StartLimitBurst=3

[Service]
User=unexpected-mushroom
WorkingDirectory=/home/unexpected-mushroom/MovieCompass/backend
# Same command as `npm start` in backend/package.json. Run node directly,
# without npm, to save the RAM of an extra Node process.
ExecStart=/usr/bin/node --max-old-space-size=160 built/index.js
Restart=always
RestartSec=5

# Hardening: if the app is ever hacked, the attacker can't use sudo, change the
# system or the home folder, or reach much of the Pi. Check with: systemd-analyze security moviecompass
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
# The only place the app writes: the SQLite database (and its -wal/-shm files).
# The folder must exist, or the service won't start (the app creates it on its first run).
ReadWritePaths=/home/unexpected-mushroom/MovieCompass/backend/data
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
# No MemoryDenyWriteExecute: Node's JIT needs writable+executable memory.

[Install]
WantedBy=multi-user.target
